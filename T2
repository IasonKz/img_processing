# 1.0 = use the complete image.
#
# If the die occupies only the central part of the raw picture,
# something like 0.50 - 0.65 may be better.
#
# Example:
# 0.55 means use the central 55% of the image width/height.
CENTER_CROP_FRACTION = 0.55

# Ignore borders after alignment because warping can create artifacts.
BORDER_IGNORE_PX = 12


# ------------------------------------------------------------
# ECC ALIGNMENT
# ------------------------------------------------------------

ECC_ITERATIONS = 250
ECC_EPSILON = 1e-6


# ------------------------------------------------------------
# CHANGE MAP WEIGHTS
# ------------------------------------------------------------

# Combined map:
#
# D = w1 * absolute_difference
#   + w2 * SSIM_difference
#   + w3 * gradient_difference

