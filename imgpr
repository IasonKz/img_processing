# -*- coding: utf-8 -*-

"""
NILT combined preprocessing for ViTop + ViBottom.

This is the same no-ECC / no-reference pipeline as the previous combined
script, but paths and tunable parameters are loaded from an external YAML file.

Run:
    python combined_preprocessing_config.py --config config.yaml

Dependencies:
    pip install opencv-python numpy pyyaml
"""

from pathlib import Path
import argparse
import os
import shutil
import cv2
import numpy as np
import yaml


