def make_top_debug(
    original,
    square,
    detection
):

    g = gray8(
        original
    )


    debug = cv2.cvtColor(
        g,
        cv2.COLOR_GRAY2BGR
    )


    points = np.round(
        square
    ).astype(
        np.int32
    )


