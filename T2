WEIGHT_SSIM = 0.35
WEIGHT_GRADIENT = 0.20


# ------------------------------------------------------------
# DEFECT MASK
# ------------------------------------------------------------

# Robust threshold:
#
# threshold = median + MAD_MULTIPLIER * sigma_MAD
#
MAD_MULTIPLIER = 6.0

# Never allow the threshold to become unrealistically low.
MIN_CHANGE_THRESHOLD = 0.10

# Connected regions smaller than this are ignored as noise.
MIN_COMPONENT_AREA_PX = 25


# ------------------------------------------------------------
# FINAL CLASSIFICATION THRESHOLDS
# ------------------------------------------------------------

# Fraction of valid image pixels marked as changed.
CHANGED_PIXEL_RATIO_THRESHOLD = 0.0020       # 0.20 %

# Largest connected changed region as fraction of image area.
MAX_COMPONENT_RATIO_THRESHOLD = 0.0008       # 0.08 %

# Global SSIM alone does NOT determine the class.
# It is used together with actual changed regions.
STRUCTURAL_SSIM_THRESHOLD = 0.975

# Extra changed-pixel requirement when SSIM is poor.
SSIM_CHANGE_RATIO_MIN = 0.0005


