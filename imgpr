# ============================================================
# CONFIG
# ============================================================

def parse_args():
    parser = argparse.ArgumentParser(
        description="Combined ViTop/ViBottom preprocessing using YAML config."
    )

    parser.add_argument(
        "--config",
        type=Path,
        required=True,
        help="Path to YAML config file, for example: --config config.yaml",
    )

    return parser.parse_args()


def resolve_config_path(value, config_dir):
    """
    Expand environment variables and ~.
    Relative paths are interpreted relative to config.yaml.
    """

    value = os.path.expandvars(
        os.path.expanduser(
            str(value)
        )
    )

    path = Path(value)

    if not path.is_absolute():
        path = config_dir / path

    return path.resolve()


def load_config(config_path):
    config_path = config_path.expanduser().resolve()

    if not config_path.is_file():
        raise SystemExit(
            f"Config file does not exist: {config_path}"
        )

    with config_path.open(
        "r",
        encoding="utf-8"
    ) as handle:
        config = yaml.safe_load(handle)

    if not isinstance(config, dict):
        raise SystemExit(
            "The YAML file must contain a mapping/dictionary at the top level."
        )

    return config, config_path.parent


def configure(config, config_dir):
    """
    Read every path and tunable parameter from YAML.

    The image-processing functions below keep the same structure as the
    previous combined script. The only change is that constants are no longer
    edited inside the Python file.
    """

    global INPUT_ROOT
    global OUTPUT_ROOT
    global DATASETS
    global IMAGE_EXTENSIONS

    global FINAL_SIZE
    global TOP_OFFSET_RATIO
    global BOTTOM_OFFSET_RATIO
    global DARK_THRESHOLD
    global MAX_BRIGHTEN

    global TOP_SEARCH_RATIO
    global TOP_MAX_CENTER_OFFSET_X
    global TOP_MAX_CENTER_OFFSET_Y
    global TOP_MIN_SIZE_RATIO
    global TOP_MAX_SIZE_RATIO
    global TOP_EXPECTED_SIZE_RATIO
    global TOP_MIN_DETECTION_SCORE
    global TOP_MAX_ROTATION_DEG

    global BOTTOM_MAX_CENTER_OFFSET_X
    global BOTTOM_MAX_CENTER_OFFSET_Y
    global BOTTOM_MIN_SIDE_RATIO
    global BOTTOM_MAX_SIDE_RATIO
    global BOTTOM_MAX_ROTATION_DEG
    global BOTTOM_MIN_DETECTION_SCORE
    global BOTTOM_EDGE_SEARCH_RATIO

    global TOP_METHOD
    global BOTTOM_METHOD
    global OUTPUT_NAMES

    try:
        paths = config["paths"]
        images = config["images"]
        common = config["common"]
        top = config["vitop"]
        bottom = config["vibottom"]

        INPUT_ROOT = resolve_config_path(
            paths["input_root"],
            config_dir
        )

        OUTPUT_ROOT = resolve_config_path(
            paths["output_root"],
            config_dir
        )

        DATASETS = []

        for item in config["datasets"]:
            DATASETS.append(
                (
                    str(item["position"]),
                    str(item["label"])
                )
            )

        IMAGE_EXTENSIONS = {
            str(extension).lower()
            if str(extension).startswith(".")
            else "." + str(extension).lower()
            for extension in images["extensions"]
        }

        FINAL_SIZE = int(
            common["final_size"]
        )

        DARK_THRESHOLD = float(
            common["lighting"]["dark_threshold"]
        )

        MAX_BRIGHTEN = float(
            common["lighting"]["max_brighten"]
        )

        TOP_OFFSET_RATIO = float(
            top["offset_ratio"]
        )

        TOP_SEARCH_RATIO = float(
            top["search_ratio"]
        )

        TOP_MAX_CENTER_OFFSET_X = float(
            top["max_center_offset_x"]
        )

        TOP_MAX_CENTER_OFFSET_Y = float(
            top["max_center_offset_y"]
        )

        TOP_MIN_SIZE_RATIO = float(
            top["min_size_ratio"]
        )

        TOP_MAX_SIZE_RATIO = float(
            top["max_size_ratio"]
        )

        TOP_EXPECTED_SIZE_RATIO = float(
            top["expected_size_ratio"]
        )

        TOP_MIN_DETECTION_SCORE = float(
            top["min_detection_score"]
        )

        TOP_MAX_ROTATION_DEG = float(
            top["max_rotation_deg"]
        )

        TOP_METHOD = dict(
            top["method"]
        )

        BOTTOM_OFFSET_RATIO = float(
            bottom["offset_ratio"]
        )

        BOTTOM_MAX_CENTER_OFFSET_X = float(
            bottom["max_center_offset_x"]
        )

        BOTTOM_MAX_CENTER_OFFSET_Y = float(
            bottom["max_center_offset_y"]
        )

        BOTTOM_MIN_SIDE_RATIO = float(
            bottom["min_side_ratio"]
        )

        BOTTOM_MAX_SIDE_RATIO = float(
            bottom["max_side_ratio"]
        )

        BOTTOM_MAX_ROTATION_DEG = float(
            bottom["max_rotation_deg"]
        )

        BOTTOM_MIN_DETECTION_SCORE = float(
            bottom["min_detection_score"]
        )

        BOTTOM_EDGE_SEARCH_RATIO = float(
            bottom["edge_search_ratio"]
        )

        BOTTOM_METHOD = dict(
            bottom["method"]
        )

        OUTPUT_NAMES = dict(
            config["output_folders"]
        )

    except KeyError as error:
        raise SystemExit(
            f"Missing YAML setting: {error}"
        ) from error

    if FINAL_SIZE <= 0:
        raise SystemExit(
            "common.final_size must be positive."
        )

    if INPUT_ROOT.resolve() == OUTPUT_ROOT.resolve():
        raise SystemExit(
            "Safety stop: paths.input_root and paths.output_root must be different."
        )


# ============================================================
# COMMON HELPERS
# ============================================================

def gray8(img):
    """
    Create an 8-bit grayscale COPY.

    Used only for:
        detection
        debug

    ORIGINAL IS NEVER MODIFIED.
    """

    if img.ndim == 3:

        if img.shape[2] == 4:

            g = cv2.cvtColor(
                img,
                cv2.COLOR_BGRA2GRAY
            )

        else:

            g = cv2.cvtColor(
                img,
                cv2.COLOR_BGR2GRAY
            )

    else:

        g = img.copy()


    if g.dtype == np.uint8:

        return g.copy()


    x = g.astype(
        np.float32
    )


    lo = float(
        np.percentile(
            x,
            1
        )
    )


    hi = float(
        np.percentile(
            x,
            99
        )
    )


    if hi <= lo:

        hi = lo + 1.0


    x = np.clip(
        (x - lo) / (hi - lo),
        0.0,
        1.0
    )


    return (
        255.0 * x
    ).astype(
        np.uint8
    )


# ============================================================
# ORDER RECTANGLE POINTS
# ============================================================

def order_points(points):

    pts = np.asarray(
        points,
        dtype=np.float32
    )


    ordered = np.zeros(
        (4, 2),
        dtype=np.float32
    )


    sums = pts.sum(
        axis=1
    )


    diffs = np.diff(
        pts,
        axis=1
    ).reshape(-1)


    ordered[0] = pts[
        np.argmin(sums)
    ]


    ordered[1] = pts[
        np.argmin(diffs)
    ]


    ordered[2] = pts[
        np.argmax(sums)
    ]


    ordered[3] = pts[
        np.argmax(diffs)
    ]


    return ordered


# ============================================================
# ROTATION ANGLE
# ============================================================

def rectangle_angle(box):

    box = order_points(
        box
    )


    tl, tr, br, bl = box


    vector = (
        tr - tl
    )


    angle = np.degrees(
        np.arctan2(
            vector[1],
            vector[0]
        )
    )


    while angle >= 45:

        angle -= 90


    while angle < -45:

        angle += 90


    return float(
        angle
    )


# ============================================================
# FINAL RESIZE
# ============================================================

def resize_to_final(image):

    H, W = image.shape[:2]


    if (
        H == FINAL_SIZE
        and
        W == FINAL_SIZE
    ):

        return image.copy()


    if (
        H > FINAL_SIZE
        or
        W > FINAL_SIZE
    ):

        interpolation = (
            cv2.INTER_AREA
        )

    else:

        interpolation = (
            cv2.INTER_CUBIC
        )


    return cv2.resize(
        image,
        (
            FINAL_SIZE,
            FINAL_SIZE
        ),
        interpolation=interpolation
    )


# ============================================================
# MILD LIGHTING
# ============================================================

def lighten_if_dark(image):
    """
    Very mild lighting correction.

    The threshold and maximum increase come from YAML.
    Bright images remain unchanged.
    """

    if not np.issubdtype(
        image.dtype,
        np.integer
    ):

        return image.copy()


    if image.ndim == 3:

        values = image.astype(
            np.float32
        ).mean(
            axis=2
        )

    else:

        values = image.astype(
            np.float32
        )


    max_value = float(
        np.iinfo(
            image.dtype
        ).max
    )


    brightness = float(
        np.mean(values)
        /
        max_value
    )


    if brightness >= DARK_THRESHOLD:

        return image.copy()


    darkness = (
        DARK_THRESHOLD
        -
        brightness
    ) / DARK_THRESHOLD


    darkness = float(
        np.clip(
            darkness,
            0.0,
            1.0
        )
    )


    factor = (
        1.0
        +
        MAX_BRIGHTEN
        * darkness
    )


    result = (
        image.astype(
            np.float32
        )
        *
        factor
    )


    result = np.clip(
        result,
        0,
        max_value
    )


    return result.astype(
        image.dtype
    )


# ============================================================
# MISSING
# ============================================================

def save_missing(
    image_path,
    original,
    missing_folder,
    missing_debug_folder,
    reason
):

    missing_folder.mkdir(
        parents=True,
        exist_ok=True
    )


    missing_debug_folder.mkdir(
        parents=True,
        exist_ok=True
    )


    destination = (
        missing_folder
        /
        image_path.name
    )


    shutil.copy2(
        str(image_path),
        str(destination)
    )


    g = gray8(
        original
    )


    debug = cv2.cvtColor(
        g,
        cv2.COLOR_GRAY2BGR
    )


    cv2.putText(
        debug,
        reason,
        (
            30,
            60
        ),
        cv2.FONT_HERSHEY_SIMPLEX,
        1.0,
        (
            0,
            0,
            255
        ),
        3,
        cv2.LINE_AA
    )


    debug_path = (
        missing_debug_folder
        /
        (
            image_path.stem
            +
            "_missing.png"
        )
    )


    cv2.imwrite(
        str(debug_path),
        debug
    )


