from pathlib import Path
import argparse
import csv
import json

import torch
import torch.nn as nn
from torch.utils.data import DataLoader
from torchvision import datasets, models, transforms

from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix,
)


def main():

    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--test",
        required=True,
        help="Path to bottom/test folder"
    )

    parser.add_argument(
        "--model",
        required=True,
        help="Path to best_bottom_model.pth"
    )

    parser.add_argument(
        "--classes",
        required=True,
        help="Path to classes.json"
    )

    parser.add_argument(
        "--output",
        default="test_predictions.csv"
    )

    parser.add_argument(
        "--batch-size",
        type=int,
        default=8
    )

    args = parser.parse_args()

    # =========================================================
    # Device
    # =========================================================

    device = torch.device(
        "cuda" if torch.cuda.is_available() else "cpu"
    )

    print(f"\nUsing device: {device}")

    if torch.cuda.is_available():
        print(torch.cuda.get_device_name(0))

    # =========================================================
    # Load class information
    # =========================================================

    with open(args.classes, "r", encoding="utf-8") as f:
        metadata = json.load(f)

    class_names = metadata["classes"]

    print("\nClasses:")
    print(class_names)

    # =========================================================
    # Transform
    # MUST be the same normalization used during training
    # =========================================================

    test_transform = transforms.Compose([

        transforms.ToTensor(),

        transforms.Normalize(
            mean=[0.485, 0.456, 0.406],
            std=[0.229, 0.224, 0.225],
        ),
    ])

    # =========================================================
    # Test dataset
    #
    # Expected:
    #
    # test/
    # ├── good/
    # └── bad/
    #
    # =========================================================

    test_dataset = datasets.ImageFolder(
        args.test,
        transform=test_transform
    )

    test_loader = DataLoader(
        test_dataset,
        batch_size=args.batch_size,
        shuffle=False,
        num_workers=0
    )

    print(f"\nTest images: {len(test_dataset)}")
    print(f"Detected mapping: {test_dataset.class_to_idx}")

    # =========================================================
    # Build same ResNet18 architecture
    # =========================================================

    model = models.resnet18(weights=None)

    number_of_features = model.fc.in_features

    model.fc = nn.Linear(
        number_of_features,
        len(class_names)
    )

    # =========================================================
    # Load trained weights
    # =========================================================

    model.load_state_dict(
        torch.load(
            args.model,
            map_location=device
        )
    )

    model = model.to(device)

    model.eval()

    # =========================================================
    # Predictions
    # =========================================================

    all_labels = []
    all_predictions = []

    rows = []

    sample_index = 0

    with torch.no_grad():

        for images, labels in test_loader:

            images = images.to(device)

            outputs = model(images)

            probabilities = torch.softmax(
                outputs,
                dim=1
            )

            predictions = torch.argmax(
                probabilities,
                dim=1
            )

            probabilities = probabilities.cpu().numpy()
            predictions = predictions.cpu().numpy()
            labels = labels.cpu().numpy()

            for i in range(len(labels)):

                image_path, _ = test_dataset.samples[
                    sample_index
                ]

                actual_index = int(labels[i])
                predicted_index = int(predictions[i])

                actual_label = class_names[
                    actual_index
                ]

                predicted_label = class_names[
                    predicted_index
                ]

                row = {
                    "image_name": Path(image_path).name,
                    "image_path": str(image_path),

                    "actual_label": actual_label,
                    "predicted_label": predicted_label,

                    "correct":
                        actual_label == predicted_label,
                }

                for class_index, class_name in enumerate(
                    class_names
                ):

                    row[
                        f"probability_{class_name}"
                    ] = float(
                        probabilities[i][class_index]
                    )

                rows.append(row)

                sample_index += 1

            all_labels.extend(labels)
            all_predictions.extend(predictions)

    # =========================================================
    # Metrics
    # =========================================================

    accuracy = accuracy_score(
        all_labels,
        all_predictions
    )

    print("\n")
    print("=" * 70)
    print("TEST RESULTS")
    print("=" * 70)

    print(
        f"\nAccuracy: "
        f"{accuracy * 100:.2f}%"
    )

    print("\nClassification report:\n")

    print(
        classification_report(
            all_labels,
            all_predictions,
            target_names=class_names,
            digits=4
        )
    )

    print("\nConfusion matrix:\n")

    print(
        confusion_matrix(
            all_labels,
            all_predictions
        )
    )

    # =========================================================
    # Save CSV
    # =========================================================

    output_path = Path(args.output)

    with open(
        output_path,
        "w",
        newline="",
        encoding="utf-8"
    ) as f:

        writer = csv.DictWriter(
            f,
            fieldnames=rows[0].keys()
        )

        writer.writeheader()
        writer.writerows(rows)

    print(
        f"\nPredictions CSV saved to:\n"
        f"{output_path}"
    )

    # =========================================================
    # Show mistakes
    # =========================================================

    wrong = [
        row
        for row in rows
        if not row["correct"]
    ]

    print("\n")
    print("=" * 70)
    print("WRONG PREDICTIONS")
    print("=" * 70)

    print(
        f"\n{len(wrong)} wrong "
        f"out of {len(rows)} images"
    )

    for row in wrong:

        print(
            f"\n{row['image_name']}"
        )

        print(
            f"Actual:    "
            f"{row['actual_label']}"
        )

        print(
            f"Predicted: "
            f"{row['predicted_label']}"
        )

        for class_name in class_names:

            probability = row[
                f"probability_{class_name}"
            ]

            print(
                f"P({class_name}) = "
                f"{probability * 100:.2f}%"
            )


if __name__ == "__main__":
    main()