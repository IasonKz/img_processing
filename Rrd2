def load_gray(path: Path) -> np.ndarray:

    img = cv2.imread(
        str(path),
        cv2.IMREAD_GRAYSCALE
    )

    if img is None:

        raise RuntimeError(
            f"Could not read image:\n{path}"
        )

    return img


# ============================================================
# SIMPLE CENTER CROP FALLBACK
# ============================================================

def center_square_from_fraction(
    img: np.ndarray,
    fraction: float
):

    h, w = img.shape

    side = int(
        round(
            min(h, w) * fraction
        )
    )

    side = max(
        32,
        min(
            side,
            min(h, w)
        )
    )

    side -= side % 2

    cx = w // 2
    cy = h // 2

    x0 = max(
        0,
        cx - side // 2
    )

    y0 = max(
        0,
        cy - side // 2
    )

    x1 = x0 + side
    y1 = y0 + side

    if x1 > w:

        x1 = w
        x0 = w - side

    if y1 > h:

        y1 = h
        y0 = h - side

    crop = img[
        y0:y1,
        x0:x1
    ].copy()

    return (
        crop,
        (x0, y0, x1, y1)
    )


# ============================================================
# AUTOMATIC CENTRAL TOP DIE DETECTION
# ============================================================

def detect_top_die_roi(
    img: np.ndarray
):

    """
    Find the approximately-square object near the centre.

    Important:
        - this is only used to FIND the crop
        - the actual crop comes from the original grayscale image
        - no resize is performed
    """

    if not AUTO_CROP:

        crop, roi = center_square_from_fraction(
            img,
            FALLBACK_CROP_FRACTION
        )

        return (
            crop,
            roi,
            "fixed_center_crop"
        )

    h, w = img.shape

    image_area = float(
        h * w
    )

    # --------------------------------------------------------
    # Use enhanced copy ONLY for detection
    # --------------------------------------------------------

    clahe = cv2.createCLAHE(
        clipLimit=2.0,
        tileGridSize=(8, 8)
    )

    detection_img = clahe.apply(
        img
    )

    detection_img = cv2.GaussianBlur(
        detection_img,
        (5, 5),
        0
    )

    # --------------------------------------------------------
    # Canny edges
    # --------------------------------------------------------

    median = float(
        np.median(
            detection_img
        )
    )

    low = int(
        max(
            0,
            0.66 * median
        )
    )

    high = int(
        min(
            255,
            max(
                low + 10,
                1.33 * median
            )
        )
    )

    edges = cv2.Canny(
        detection_img,
        low,
        high
    )

    # Join broken square edges

    kernel = cv2.getStructuringElement(
        cv2.MORPH_RECT,
        (5, 5)
    )

    edges = cv2.morphologyEx(
        edges,
        cv2.MORPH_CLOSE,
        kernel,
        iterations=2
    )

    edges = cv2.dilate(
        edges,
        np.ones(
            (3, 3),
            np.uint8
        ),
        iterations=1
    )

    # --------------------------------------------------------
    # Find candidate contours
    # --------------------------------------------------------

    contours, _ = cv2.findContours(
        edges,
        cv2.RETR_LIST,
        cv2.CHAIN_APPROX_SIMPLE
    )

    best_candidate = None

    best_score = -1e9

    image_cx = w / 2.0
    image_cy = h / 2.0

    max_center_distance = np.hypot(
        w / 2.0,
        h / 2.0
    )

    for contour in contours:

        if len(contour) < 4:
            continue

        rect = cv2.minAreaRect(
            contour
        )

        (
            (cx, cy),
            (rect_w, rect_h),
            angle
        ) = rect

        if rect_w < 15 or rect_h < 15:
            continue

        rect_area = float(
            rect_w * rect_h
        )

        area_fraction = (
            rect_area
            / image_area
        )

        if not (
            MIN_DIE_AREA_FRACTION
            <= area_fraction
            <= MAX_DIE_AREA_FRACTION
        ):
            continue

        # ----------------------------------------------------
        # How square is it?
        # ----------------------------------------------------

        squareness = (
            min(
                rect_w,
                rect_h
            )
            /
            max(
                rect_w,
                rect_h
            )
        )

        if (
            squareness
            < MIN_SQUARENESS
        ):
            continue

        # ----------------------------------------------------
        # Prefer objects close to center
        # ----------------------------------------------------

        center_distance = (
            np.hypot(
                cx - image_cx,
                cy - image_cy
            )
            /
            max_center_distance
        )

        center_score = max(
            0.0,
            1.0 - center_distance
        )

        # ----------------------------------------------------
        # Prefer expected die size
        # ----------------------------------------------------

        log_area_error = abs(
            np.log(
                (
                    area_fraction
                    + 1e-9
                )
                /
                EXPECTED_DIE_AREA_FRACTION
            )
        )

        area_score = float(
            np.exp(
                -1.2
                * log_area_error
            )
        )

        # ----------------------------------------------------
        # Contour filling score
        # ----------------------------------------------------

        contour_area = abs(
            float(
                cv2.contourArea(
                    contour
                )
            )
        )

        fill_ratio = min(
            1.0,
            contour_area
            /
            (
                rect_area
                + 1e-9
            )
        )

        # ----------------------------------------------------
        # Overall candidate score
        # ----------------------------------------------------

        score = (
            4.0 * center_score
            +
            3.0 * squareness
            +
            2.0 * area_score
            +
            0.5 * fill_ratio
        )

        if score > best_score:

            best_score = score

            best_candidate = (
                cx,
                cy,
                rect_w,
                rect_h
            )

    # --------------------------------------------------------
    # Fallback if detection failed
    # --------------------------------------------------------

    if best_candidate is None:

        crop, roi = center_square_from_fraction(
            img,
            FALLBACK_CROP_FRACTION
        )

        return (
            crop,
            roi,
            "fallback_center_crop"
        )

    cx, cy, rect_w, rect_h = (
        best_candidate
    )

    # --------------------------------------------------------
    # Square crop around the detected die
    # --------------------------------------------------------

    side = int(
        round(
            max(
                rect_w,
                rect_h
            )
            * CROP_MARGIN
        )
    )

    side = max(
        32,
        min(
            side,
            min(h, w)
        )
    )

    side -= side % 2

    x0 = int(
        round(
            cx - side / 2
        )
    )

    y0 = int(
        round(
            cy - side / 2
        )
    )

    x0 = min(
        max(
            0,
            x0
        ),
        w - side
    )

    y0 = min(
        max(
            0,
            y0
        ),
        h - side
    )

    x1 = x0 + side
    y1 = y0 + side

    crop = img[
        y0:y1,
        x0:x1
    ].copy()

    return (
        crop,
        (x0, y0, x1, y1),
        "auto_die_detection"
    )


