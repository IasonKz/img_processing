# ============================================================
# FORCE BOTH CROPS TO SAME SQUARE SIZE
# ============================================================

def center_crop_to_size(
    img: np.ndarray,
    size: int
):

    h, w = img.shape

    size = min(
        size,
        h,
        w
    )

    size -= size % 2

    y0 = (
        h - size
    ) // 2

    x0 = (
        w - size
    ) // 2

    return img[
        y0:y0 + size,
        x0:x0 + size
    ].copy()


def make_same_square(
    a: np.ndarray,
    b: np.ndarray
):

    size = min(
        a.shape[0],
        a.shape[1],
        b.shape[0],
        b.shape[1]
    )

    return (
        center_crop_to_size(
            a,
            size
        ),
        center_crop_to_size(
            b,
            size
        )
    )


# ============================================================
# ROTATIONS
# ============================================================

def rotate90(
    img: np.ndarray,
    deg: int
):

    if deg == 0:

        return img.copy()

    if deg == 90:

        return cv2.rotate(
            img,
            cv2.ROTATE_90_CLOCKWISE
        )

    if deg == 180:

        return cv2.rotate(
            img,
            cv2.ROTATE_180
        )

    if deg == 270:

        return cv2.rotate(
            img,
            cv2.ROTATE_90_COUNTERCLOCKWISE
        )

    raise ValueError(
        deg
    )


# ============================================================
# PREPROCESS FOR ECC
# ============================================================

def ecc_input(
    img: np.ndarray
):

    x = cv2.GaussianBlur(
        img,
        (5, 5),
        0
    ).astype(
        np.float32
    )

    x /= 255.0

    mean = float(
        x.mean()
    )

    std = float(
        x.std()
    )

    if std < 1e-7:

        return np.zeros_like(
            x,
            dtype=np.float32
        )

    return (
        x - mean
    ) / std


# ============================================================
# EDGE IMAGE FOR COARSE TRANSLATION
# ============================================================

def phase_image(
    img: np.ndarray
):

    x = cv2.GaussianBlur(
        img,
        (5, 5),
        0
    ).astype(
        np.float32
    )

    x /= 255.0

    gx = cv2.Sobel(
        x,
        cv2.CV_32F,
        1,
        0,
        ksize=3
    )

    gy = cv2.Sobel(
        x,
        cv2.CV_32F,
        0,
        1,
        ksize=3
    )

    magnitude = cv2.magnitude(
        gx,
        gy
    )

    magnitude -= float(
        magnitude.mean()
    )

    return magnitude


# ============================================================
# COARSE TRANSLATION ALIGNMENT
# ============================================================

def phase_align(
    reference: np.ndarray,
    moving: np.ndarray
):

    ref = phase_image(
        reference
    )

    mov = phase_image(
        moving
    )

    h, w = reference.shape

    window = cv2.createHanningWindow(
        (w, h),
        cv2.CV_32F
    )

    try:

        (
            dx,
            dy
        ), response = cv2.phaseCorrelate(
            ref,
            mov,
            window
        )

    except cv2.error:

        return (
            moving.copy(),
            -1.0
        )

    max_shift = (
        MAX_PHASE_SHIFT_FRACTION
        * min(
            h,
            w
        )
    )

    if (
        abs(dx) > max_shift
        or
        abs(dy) > max_shift
    ):

        return (
            moving.copy(),
            float(response)
        )

    # Move Final back onto Start
    matrix = np.array(
        [
            [
                1.0,
                0.0,
                -dx
            ],
            [
                0.0,
                1.0,
                -dy
            ]
        ],
        dtype=np.float32
    )

    aligned = cv2.warpAffine(
        moving,
        matrix,
        (w, h),
        flags=cv2.INTER_LINEAR,
        borderMode=cv2.BORDER_REFLECT101
    )

    return (
        aligned,
        float(response)
    )


# ============================================================
# FINE ECC ALIGNMENT
# ============================================================

def ecc_fine_align(
    reference: np.ndarray,
    moving: np.ndarray
):

    template = ecc_input(
        reference
    )

    input_image = ecc_input(
        moving
    )

    h, w = reference.shape

    criteria = (
        cv2.TERM_CRITERIA_EPS
        |
        cv2.TERM_CRITERIA_COUNT,
        ECC_ITERATIONS,
        ECC_EPSILON
    )

    # Try Euclidean first:
    # translation + small rotation
    #
    # If it fails, try only translation.

    motion_types = (
        cv2.MOTION_EUCLIDEAN,
        cv2.MOTION_TRANSLATION
    )

    for motion_type in motion_types:

        warp = np.eye(
            2,
            3,
            dtype=np.float32
        )

        try:

            score, warp = (
                cv2.findTransformECC(
                    template,
                    input_image,
                    warp,
                    motion_type,
                    criteria,
                    None,
                    5
                )
            )

            aligned = cv2.warpAffine(
                moving,
                warp,
                (w, h),
                flags=(
                    cv2.INTER_LINEAR
                    |
                    cv2.WARP_INVERSE_MAP
                ),
                borderMode=(
                    cv2.BORDER_REFLECT101
                )
            )

            return (
                aligned,
                float(score)
            )

        except cv2.error:

            continue

    return (
        moving.copy(),
        -1.0
    )


# ============================================================
# BRIGHTNESS / CONTRAST MATCHING
# ============================================================

def photometric_match(
    reference: np.ndarray,
    moving: np.ndarray
):

    ref = reference.astype(
        np.float32
    )

    mov = moving.astype(
        np.float32
    )

    mean_ref = float(
        ref.mean()
    )

    std_ref = float(
        ref.std()
    )

    mean_mov = float(
        mov.mean()
    )

    std_mov = float(
        mov.std()
    )

    if std_mov < 1e-6:

        return moving.copy()

    scale = (
        std_ref
        /
        std_mov
    )

    # Don't allow extreme changes
    scale = np.clip(
        scale,
        0.70,
        1.40
    )

    offset = (
        mean_ref
        -
        scale * mean_mov
    )

    offset = np.clip(
        offset,
        -45.0,
        45.0
    )

    result = (
        scale * mov
        +
        offset
    )

    return np.clip(
        result,
        0,
        255
    ).astype(
        np.uint8
    )


# ============================================================
# SMALL INNER REGION FOR ALIGNMENT QUALITY
# ============================================================

def inner_view(
    img: np.ndarray,
    border_fraction=0.05
):

    h, w = img.shape

    border = int(
        round(
            min(
                h,
                w
            )
            * border_fraction
        )
    )

    if (
        2 * border
        >= min(
            h,
            w
        )
    ):

        return img

    return img[
        border:h-border,
        border:w-border
    ]


# ============================================================
# TRY 0 / 90 / 180 / 270 AND ALIGN
# ============================================================

def best_rotation_and_alignment(
    start_crop: np.ndarray,
    final_crop: np.ndarray
):

    best_result = None
    best_score = -1e9

    for rotation in (
        0,
        90,
        180,
        270
    ):

        candidate = rotate90(
            final_crop,
            rotation
        )

        # ----------------------------------------------------
        # Coarse translation first
        # ----------------------------------------------------

        candidate, phase_response = (
            phase_align(
                start_crop,
                candidate
            )
        )

        # ----------------------------------------------------
        # Fine alignment
        # ----------------------------------------------------

        candidate, ecc_score = (
            ecc_fine_align(
                start_crop,
                candidate
            )
        )

        # ----------------------------------------------------
        # Brightness / contrast correction
        # ----------------------------------------------------

        candidate = photometric_match(
            start_crop,
            candidate
        )

        # ----------------------------------------------------
        # Compare alignment quality
        # ----------------------------------------------------

        ref_inner = inner_view(
            start_crop
        )

        mov_inner = inner_view(
            candidate
        )

        ssim_score = float(
            structural_similarity(
                ref_inner,
                mov_inner,
                data_range=255
            )
        )

        # SSIM is the main score
        score = (
            ssim_score
            +
            0.02
            * max(
                ecc_score,
                0.0
            )
            +
            0.005
            * max(
                phase_response,
                0.0
            )
        )

        if score > best_score:

            best_score = score

            best_result = (
                candidate,
                rotation,
                phase_response,
                ecc_score,
                ssim_score
            )

    assert best_result is not None

    return best_result


# ============================================================
# VALID REGION MASK
# ============================================================

def valid_mask(
    shape
):

    h, w = shape

    mask = np.ones(
        (
            h,
            w
        ),
        dtype=np.uint8
    )

    border = min(
        BORDER_IGNORE_PX,
        max(
            0,
            min(
                h,
                w
            ) // 10
        )
    )

    if border > 0:

        mask[
            :border,
            :
        ] = 0

        mask[
            -border:,
            :
        ] = 0

        mask[
            :,
            :border
        ] = 0

        mask[
            :,
            -border:
        ] = 0

    return mask


# ============================================================
# ROBUST MAD THRESHOLD
# ============================================================

def robust_threshold(
    array: np.ndarray,
    mask: np.ndarray,
    k: float,
    minimum: float
):

    values = array[
        mask > 0
    ]

    if values.size == 0:

        return minimum

    median = float(
        np.median(
            values
        )
    )

    mad = float(
        np.median(
            np.abs(
                values
                -
                median
            )
        )
    )

    robust_sigma = (
        1.4826
        * mad
    )

    threshold = (
        median
        +
        k
        * robust_sigma
    )

    return max(
        minimum,
        threshold
    )


# ============================================================
# GRADIENT MAGNITUDE
# ============================================================

def gradient_magnitude(
    img: np.ndarray
):

    x = cv2.GaussianBlur(
        img,
        (3, 3),
        0
    ).astype(
        np.float32
    )

    x /= 255.0

    gx = cv2.Sobel(
        x,
        cv2.CV_32F,
        1,
        0,
        ksize=3
    )

    gy = cv2.Sobel(
        x,
        cv2.CV_32F,
        0,
        1,
        ksize=3
    )

    return cv2.magnitude(
        gx,
        gy
    )


# ============================================================
# BUILD DIFFERENCE MAPS
# ============================================================

def build_change_maps(
    start: np.ndarray,
    final: np.ndarray
):

    # Tiny blur to suppress sensor noise
    start_blur = cv2.GaussianBlur(
        start,
        (3, 3),
        0.7
    )

    final_blur = cv2.GaussianBlur(
        final,
        (3, 3),
        0.7
    )

    # --------------------------------------------------------
    # Absolute pixel difference
    # --------------------------------------------------------

    abs_map = cv2.absdiff(
        start_blur,
        final_blur
    ).astype(
        np.float32
    )

    abs_map /= 255.0

    # --------------------------------------------------------
    # SSIM difference
    # --------------------------------------------------------

    global_ssim, similarity_map = (
        structural_similarity(
            start_blur,
            final_blur,
            data_range=255,
            full=True
        )
    )

    ssim_difference = np.clip(
        1.0
        -
        similarity_map.astype(
            np.float32
        ),
        0.0,
        1.0
    )

    # --------------------------------------------------------
    # Gradient difference
    # --------------------------------------------------------

    gradient_difference = np.abs(
        gradient_magnitude(
            start_blur
        )
        -
        gradient_magnitude(
            final_blur
        )
    )

    gradient_scale = float(
        np.percentile(
            gradient_difference,
            99.5
        )
    )

    if gradient_scale > 1e-8:

        gradient_difference = (
            gradient_difference
            /
            gradient_scale
        )

        gradient_difference = np.clip(
            gradient_difference,
            0.0,
            1.0
        )

    else:

        gradient_difference = (
            np.zeros_like(
                gradient_difference,
                dtype=np.float32
            )
        )

    # --------------------------------------------------------
    # Combined map
    # --------------------------------------------------------

    combined = (
        WEIGHT_ABSDIFF
        * abs_map
        +
        WEIGHT_SSIM
        * ssim_difference
        +
        WEIGHT_GRADIENT
        * gradient_difference
    )

    combined = np.clip(
        combined,
        0.0,
        1.0
    )

    return (
        abs_map,
        ssim_difference,
        gradient_difference,
        combined,
        float(global_ssim)
    )


# ============================================================
# CREATE CHANGE MASK
# ============================================================

def make_change_mask(
    abs_map,
    ssim_map,
    gradient_map,
    combined,
    mask
):

    combined_threshold = (
        robust_threshold(
            combined,
            mask,
            COMBINED_MAD_K,
            MIN_COMBINED_THRESHOLD
        )
    )

    abs_threshold = (
        robust_threshold(
            abs_map,
            mask,
            ABSDIFF_MAD_K,
            MIN_ABSDIFF_THRESHOLD
        )
    )

    ssim_threshold = (
        robust_threshold(
            ssim_map,
            mask,
            SSIM_MAD_K,
            MIN_SSIM_DIFF_THRESHOLD
        )
    )

    gradient_threshold = (
        robust_threshold(
            gradient_map,
            mask,
            GRAD_MAD_K,
            MIN_GRAD_DIFF_THRESHOLD
        )
    )

    # --------------------------------------------------------
    # Count independent evidence
    # --------------------------------------------------------

    evidence_count = (
        (
            abs_map
            >
            abs_threshold
        ).astype(
            np.uint8
        )
        +
        (
            ssim_map
            >
            ssim_threshold
        ).astype(
            np.uint8
        )
        +
        (
            gradient_map
            >
            gradient_threshold
        ).astype(
            np.uint8
        )
    )

    # Require at least two methods to agree.
    # This is important for reducing false positives.

    binary = (
        (
            combined
            >
            combined_threshold
        )
        &
        (
            evidence_count
            >= 2
        )
        &
        (
            mask > 0
        )
    ).astype(
        np.uint8
    )

    # --------------------------------------------------------
    # Morphological cleaning
    # --------------------------------------------------------

    open_kernel = (
        cv2.getStructuringElement(
            cv2.MORPH_ELLIPSE,
            (3, 3)
        )
    )

    close_kernel = (
        cv2.getStructuringElement(
            cv2.MORPH_ELLIPSE,
            (5, 5)
        )
    )

    binary = cv2.morphologyEx(
        binary,
        cv2.MORPH_OPEN,
        open_kernel
    )

    binary = cv2.morphologyEx(
        binary,
        cv2.MORPH_CLOSE,
        close_kernel
    )

    return (
        binary,
        combined_threshold
    )


# ============================================================
# REMOVE SMALL COMPONENTS
# ============================================================

def filter_components(
    binary,
    mask
):

    (
        number_labels,
        labels,
        stats,
        centroids
    ) = cv2.connectedComponentsWithStats(
        binary,
        connectivity=8
    )

    cleaned = np.zeros_like(
        binary
    )

    areas = []

    for label in range(
        1,
        number_labels
    ):

        area = int(
            stats[
                label,
                cv2.CC_STAT_AREA
            ]
        )

        if (
            area
            <
            MIN_COMPONENT_AREA_PX
        ):

            continue

        cleaned[
            labels == label
        ] = 1

        areas.append(
            area
        )

    valid_pixels = max(
        1,
        int(
            np.sum(
                mask > 0
            )
        )
    )

    changed_pixels = int(
        np.sum(
            cleaned > 0
        )
    )

    changed_ratio = (
        changed_pixels
        /
        valid_pixels
    )

    if areas:

        max_area = max(
            areas
        )

    else:

        max_area = 0

    max_ratio = (
        max_area
        /
        valid_pixels
    )

    return (
        cleaned,
        changed_ratio,
        max_area,
        max_ratio,
        len(areas)
    )


# ============================================================
# FINAL CLASSIFICATION
# ============================================================

def classify(
    global_ssim,
    changed_ratio,
    max_component_ratio
):

    # --------------------------------------------------------
    # Condition 1:
    # strong localized defect
    # --------------------------------------------------------

    if (
        max_component_ratio
        >=
        STRONG_LOCAL_COMPONENT_RATIO
    ):

        return (
            "not_similar",
            "strong_local_change"
        )

    # --------------------------------------------------------
    # Condition 2:
    # large total change
    # --------------------------------------------------------

    if (
        changed_ratio
        >=
        TOTAL_CHANGE_RATIO
    ):

        return (
            "not_similar",
            "large_total_change"
        )

    # --------------------------------------------------------
    # Condition 3:
    # moderate change + poor structural similarity
    # --------------------------------------------------------

    if (
        global_ssim
        <
        LOW_GLOBAL_SSIM
        and
        changed_ratio
        >=
        LOW_SSIM_CHANGE_RATIO
    ):

        return (
            "not_similar",
            "changed_area_and_low_ssim"
        )

    return (
        "similar",
        "no_convincing_new_defect"
    )


# ============================================================
# VISUAL HELPERS
# ============================================================

def to_uint8(
    array
):

    return np.clip(
        array * 255.0,
        0,
        255
    ).astype(
        np.uint8
    )


def make_heatmap(
    array
):

    return cv2.applyColorMap(
        to_uint8(
            array
        ),
        cv2.COLORMAP_JET
    )


def overlay_changes(
    final,
    binary
):

    visual = cv2.cvtColor(
        final,
        cv2.COLOR_GRAY2BGR
    )

    contours, _ = (
        cv2.findContours(
            (
                binary
                * 255
            ).astype(
                np.uint8
            ),
            cv2.RETR_EXTERNAL,
            cv2.CHAIN_APPROX_SIMPLE
        )
    )

    cv2.drawContours(
        visual,
        contours,
        -1,
        (0, 255, 0),
        2
    )

    return visual


# ============================================================
# UNIT ID
# ============================================================

def extract_unit(
    path: Path
) -> Optional[str]:

    match = UNIT_RE.search(
        path.name
    )

    if match:

        return match.group(1)

    return None


# ============================================================
# TIMESTAMP FOR RETEST PAIRING
# ============================================================

def extract_timestamp(
    path: Path
):

    match = TIMESTAMP_RE.search(
        path.name
    )

    if match:

        try:

            timestamp = datetime.strptime(
                match.group(1),
                "%Y%m%dT%H%M%S"
            )

            return (
                0,
                timestamp
            )

        except ValueError:

            pass

    # Fallback: alphabetical order
    return (
        1,
        path.name.lower()
    )


# ============================================================
# FIND ALL TOP START / FINAL
# ============================================================

def discover(
    root: Path
):

    starts = {}
    finals = {}

    for path in root.rglob("*"):

        if not path.is_file():
            continue

        if (
            path.suffix.lower()
            not in
            IMAGE_EXTENSIONS
        ):

            continue

        unit = extract_unit(
            path
        )

        if unit is None:
            continue

        filename = (
            path.name.lower()
        )

        if (
            START_TOKEN.lower()
            in filename
        ):

            starts.setdefault(
                unit,
                []
            ).append(
                path
            )

        elif (
            FINAL_TOKEN.lower()
            in filename
        ):

            finals.setdefault(
                unit,
                []
            ).append(
                path
            )

    # Sort chronologically
    for dictionary in (
        starts,
        finals
    ):

        for images in (
            dictionary.values()
        ):

            images.sort(
                key=extract_timestamp
            )

    return (
        starts,
        finals
    )


# ============================================================
# BUILD START / FINAL PAIRS
# ============================================================

def build_pairs(
    starts,
    finals
):

    pairs = []

    all_units = sorted(
        set(
            starts
        )
        |
        set(
            finals
        )
    )

    for unit in all_units:

        start_images = starts.get(
            unit,
            []
        )

        final_images = finals.get(
            unit,
            []
        )

        if (
            len(start_images)
            !=
            len(final_images)
        ):

            print(
                f"WARNING {unit}: "
                f"{len(start_images)} Start, "
                f"{len(final_images)} Final."
            )

            print(
                "Pairing chronologically "
                "up to the shorter list."
            )

        for pair_number, (
            start_path,
            final_path
        ) in enumerate(
            zip(
                start_images,
                final_images
            ),
            start=1
        ):

            pairs.append(
                (
                    unit,
                    pair_number,
                    start_path,
                    final_path
                )
            )

    return pairs


# ============================================================
# PROCESS ONE PAIR
# ============================================================

def process_pair(
    unit,
    pair_number,
    start_path,
    final_path
):

    # --------------------------------------------------------
    # Load ORIGINAL images
    # --------------------------------------------------------

    start_original = load_gray(
        start_path
    )

    final_original = load_gray(
        final_path
    )

    # ========================================================
    # STEP 1
    # CROP TOP IMAGES FIRST
    # ========================================================

    (
        start_crop,
        start_roi,
        start_crop_method
    ) = detect_top_die_roi(
        start_original
    )

    (
        final_crop,
        final_roi,
        final_crop_method
    ) = detect_top_die_roi(
        final_original
    )

    # Same size, but still NO scaling
    (
        start_crop,
        final_crop
    ) = make_same_square(
        start_crop,
        final_crop
    )

    # ========================================================
    # STEP 2
    # ALIGN START / FINAL TO EACH OTHER
    # ========================================================

    (
        final_aligned,
        rotation,
        phase_response,
        ecc_score,
        rotation_ssim
    ) = best_rotation_and_alignment(
        start_crop,
        final_crop
    )

    # ========================================================
    # STEP 3
    # ONLY NOW COMPARE THE PAIR
    # ========================================================

    (
        abs_map,
        ssim_map,
        gradient_map,
        combined_map,
        global_ssim
    ) = build_change_maps(
        start_crop,
        final_aligned
    )

    mask = valid_mask(
        combined_map.shape
    )

    (
        raw_change_mask,
        combined_threshold
    ) = make_change_mask(
        abs_map,
        ssim_map,
        gradient_map,
        combined_map,
        mask
    )

    (
        clean_change_mask,
        changed_ratio,
        max_component_area,
        max_component_ratio,
        number_components
    ) = filter_components(
        raw_change_mask,
        mask
    )

    (
        classification,
        reason
    ) = classify(
        global_ssim,
        changed_ratio,
        max_component_ratio
    )

    # ========================================================
    # CREATE OUTPUT FOLDER
    # ========================================================

    pair_name = (
        f"{unit}_pair_{pair_number:02d}"
    )

    output_dir = (
        OUTPUT_ROOT
        /
        classification
        /
        pair_name
    )

    output_dir.mkdir(
        parents=True,
        exist_ok=True
    )

    # --------------------------------------------------------
    # Copy originals
    # --------------------------------------------------------

    shutil.copy2(
        start_path,
        output_dir
        /
        f"start_original{start_path.suffix}"
    )

    shutil.copy2(
        final_path,
        output_dir
        /
        f"final_original{final_path.suffix}"
    )

    # --------------------------------------------------------
    # Show what was cropped
    # --------------------------------------------------------

    cv2.imwrite(
        str(
            output_dir
            /
            "start_crop_debug.png"
        ),
        draw_roi(
            start_original,
            start_roi,
            start_crop_method
        )
    )

    cv2.imwrite(
        str(
            output_dir
            /
            "final_crop_debug.png"
        ),
        draw_roi(
            final_original,
            final_roi,
            final_crop_method
        )
    )

    # --------------------------------------------------------
    # Actual images used for comparison
    # --------------------------------------------------------

    cv2.imwrite(
        str(
            output_dir
            /
            "start_cropped.png"
        ),
        start_crop
    )

    cv2.imwrite(
        str(
            output_dir
            /
            "final_cropped_before_alignment.png"
        ),
        final_crop
    )

    cv2.imwrite(
        str(
            output_dir
            /
            "final_aligned.png"
        ),
        final_aligned
    )

    # --------------------------------------------------------
    # Difference maps
    # --------------------------------------------------------

    cv2.imwrite(
        str(
            output_dir
            /
            "absolute_difference.png"
        ),
        to_uint8(
            abs_map
        )
    )

    cv2.imwrite(
        str(
            output_dir
            /
            "ssim_difference.png"
        ),
        to_uint8(
            ssim_map
        )
    )

    cv2.imwrite(
        str(
            output_dir
            /
            "gradient_difference.png"
        ),
        to_uint8(
            gradient_map
        )
    )

    cv2.imwrite(
        str(
            output_dir
            /
            "combined_heatmap.png"
        ),
        make_heatmap(
            combined_map
        )
    )

    cv2.imwrite(
        str(
            output_dir
            /
            "change_mask.png"
        ),
        clean_change_mask
        * 255
    )

    cv2.imwrite(
        str(
            output_dir
            /
            "detected_changes.png"
        ),
        overlay_changes(
            final_aligned,
            clean_change_mask
        )
    )

    # ========================================================
    # METRICS
    # ========================================================

    result = PairResult(

        unit=unit,

        pair_number=(
            pair_number
        ),

        start_path=(
            str(
                start_path
            )
        ),

        final_path=(
            str(
                final_path
            )
        ),

        start_crop_method=(
            start_crop_method
        ),

        final_crop_method=(
            final_crop_method
        ),

        selected_rotation_deg=(
            rotation
        ),

        phase_response=(
            phase_response
        ),

        ecc_score=(
            ecc_score
        ),

        global_ssim=(
            global_ssim
        ),

        combined_threshold=(
            combined_threshold
        ),

        changed_pixel_ratio=(
            changed_ratio
        ),

        max_component_area_px=(
            max_component_area
        ),

        max_component_ratio=(
            max_component_ratio
        ),

        number_components=(
            number_components
        ),

        classification=(
            classification
        ),

        reason=(
            reason
        )
    )

    # Save per-pair JSON

    with open(
        output_dir
        /
        "metrics.json",
        "w",
        encoding="utf-8"
    ) as file:

        json.dump(
            asdict(
                result
            ),
            file,
            indent=2
        )

    return result


# ============================================================
# SAVE ALL METRICS TO CSV
# ============================================================

def save_csv(
    results
):

    if not results:
        return

    csv_path = (
        OUTPUT_ROOT
        /
        "metrics.csv"
    )

    with open(
        csv_path,
        "w",
        newline="",
        encoding="utf-8"
    ) as file:

        writer = csv.DictWriter(
            file,
            fieldnames=list(
                asdict(
                    results[0]
                ).keys()
            )
        )

        writer.writeheader()

        for result in results:

            writer.writerow(
                asdict(
                    result
                )
            )


