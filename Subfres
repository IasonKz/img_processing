def load_gray(path: Path) -> np.ndarray:
    """
    Load an image as grayscale.

    Does NOT modify the original file.
    """

    image = cv2.imread(
        str(path),
        cv2.IMREAD_GRAYSCALE,
    )

    if image is None:
        raise RuntimeError(
            f"Could not read image:\n{path}"
        )

    return image


# ============================================================
# SIMPLE CENTER CROP
# ============================================================

def center_square_from_fraction(
    image: np.ndarray,
    fraction: float,
):
    """
    Central square crop.

    Used only as fallback if automatic die detection fails.
    No resizing.
    """

    h, w = image.shape

    side = int(
        round(
            min(h, w) * fraction
        )
    )

    side = max(
        32,
        min(
            side,
            min(h, w),
        ),
    )

    # Keep even size
    side -= side % 2

    cx = w // 2
    cy = h // 2

    x0 = cx - side // 2
    y0 = cy - side // 2

    x0 = max(
        0,
        min(
            x0,
            w - side,
        ),
    )

    y0 = max(
        0,
        min(
            y0,
            h - side,
        ),
    )

    crop = image[
        y0:y0 + side,
        x0:x0 + side
    ].copy()

    return crop


# ============================================================
# AUTOMATIC TOP DIE DETECTION
# ============================================================

def detect_top_die(
    image: np.ndarray,
) -> np.ndarray:
    """
    Detect the approximately-square central TOP die.

    IMPORTANT:
    The enhanced/filtered image is used ONLY to FIND the ROI.

    The returned crop always comes from the original
    grayscale image.

    No scaling/resizing is done.
    """

    if not AUTO_CROP:
        return center_square_from_fraction(
            image,
            FALLBACK_CROP_FRACTION,
        )

    h, w = image.shape

    image_area = float(
        h * w
    )

    image_cx = w / 2.0
    image_cy = h / 2.0

    maximum_center_distance = np.hypot(
        w / 2.0,
        h / 2.0,
    )

    # ========================================================
    # Detection-only preprocessing
    # ========================================================

    clahe = cv2.createCLAHE(
        clipLimit=2.0,
        tileGridSize=(8, 8),
    )

    detection_image = clahe.apply(
        image
    )

    detection_image = cv2.GaussianBlur(
        detection_image,
        (5, 5),
        0,
    )

    # ========================================================
    # Adaptive Canny
    # ========================================================

    med = float(
        np.median(
            detection_image
        )
    )

    canny_low = int(
        max(
            0,
            0.60 * med,
        )
    )

    canny_high = int(
        min(
            255,
            max(
                canny_low + 15,
                1.40 * med,
            ),
        )
    )

    edges = cv2.Canny(
        detection_image,
        canny_low,
        canny_high,
    )

    # Connect broken square edges
    close_kernel = cv2.getStructuringElement(
        cv2.MORPH_RECT,
        (5, 5),
    )

    edges = cv2.morphologyEx(
        edges,
        cv2.MORPH_CLOSE,
        close_kernel,
        iterations=2,
    )

    edges = cv2.dilate(
        edges,
        np.ones(
            (3, 3),
            dtype=np.uint8,
        ),
        iterations=1,
    )

    # ========================================================
    # Search contours
    # ========================================================

    contours, _ = cv2.findContours(
        edges,
        cv2.RETR_LIST,
        cv2.CHAIN_APPROX_SIMPLE,
    )

    best_candidate = None
    best_score = -1e30

    for contour in contours:

        if len(contour) < 4:
            continue

        rect = cv2.minAreaRect(
            contour
        )

        (
            (cx, cy),
            (rect_w, rect_h),
            angle,
        ) = rect

        if rect_w < 20 or rect_h < 20:
            continue

        rect_area = float(
            rect_w * rect_h
        )

        area_fraction = (
            rect_area
            / image_area
        )

        if not (
            MIN_DIE_AREA_FRACTION
            <= area_fraction
            <= MAX_DIE_AREA_FRACTION
        ):
            continue

        # ----------------------------------------------------
        # Squareness
        # ----------------------------------------------------

        squareness = (
            min(
                rect_w,
                rect_h,
            )
            /
            max(
                rect_w,
                rect_h,
            )
        )

        if squareness < MIN_SQUARENESS:
            continue

        # ----------------------------------------------------
        # Distance to image centre
        # ----------------------------------------------------

        center_distance = (
            np.hypot(
                cx - image_cx,
                cy - image_cy,
            )
            /
            maximum_center_distance
        )

        center_score = max(
            0.0,
            1.0 - center_distance,
        )

        # ----------------------------------------------------
        # Expected size
        # ----------------------------------------------------

        area_error = abs(
            np.log(
                (
                    area_fraction + 1e-9
                )
                /
                EXPECTED_DIE_AREA_FRACTION
            )
        )

        area_score = float(
            np.exp(
                -1.2 * area_error
            )
        )

        # ----------------------------------------------------
        # Contour filling
        # ----------------------------------------------------

        actual_contour_area = abs(
            float(
                cv2.contourArea(
                    contour
                )
            )
        )

        fill_ratio = min(
            1.0,
            actual_contour_area
            /
            (
                rect_area + 1e-9
            ),
        )

        # ----------------------------------------------------
        # Final candidate score
        # ----------------------------------------------------

        score = (
            5.0 * center_score
            +
            3.0 * squareness
            +
            2.5 * area_score
            +
            0.5 * fill_ratio
        )

        if score > best_score:

            best_score = score

            best_candidate = (
                cx,
                cy,
                rect_w,
                rect_h,
            )

    # ========================================================
    # Fallback
    # ========================================================

    if best_candidate is None:

        return center_square_from_fraction(
            image,
            FALLBACK_CROP_FRACTION,
        )

    # ========================================================
    # Build square crop around detected die
    # ========================================================

    (
        cx,
        cy,
        rect_w,
        rect_h,
    ) = best_candidate

    side = int(
        round(
            max(
                rect_w,
                rect_h,
            )
            * CROP_MARGIN
        )
    )

    side = max(
        32,
        min(
            side,
            min(h, w),
        ),
    )

    side -= side % 2

    x0 = int(
        round(
            cx - side / 2
        )
    )

    y0 = int(
        round(
            cy - side / 2
        )
    )

    x0 = max(
        0,
        min(
            x0,
            w - side,
        ),
    )

    y0 = max(
        0,
        min(
            y0,
            h - side,
        ),
    )

    crop = image[
        y0:y0 + side,
        x0:x0 + side
    ].copy()

    return crop


# ============================================================
# FORCE START AND FINAL TO SAME SIZE WITHOUT RESIZING
# ============================================================

def center_crop_to_size(
    image: np.ndarray,
    size: int,
) -> np.ndarray:

    h, w = image.shape

    size = min(
        size,
        h,
        w,
    )

    size -= size % 2

    x0 = (
        w - size
    ) // 2

    y0 = (
        h - size
    ) // 2

    return image[
        y0:y0 + size,
        x0:x0 + size
    ].copy()


def make_same_square(
    start: np.ndarray,
    final: np.ndarray,
):
    """
    Do NOT resize.

    Simply take the largest common central square.
    """

    size = min(
        start.shape[0],
        start.shape[1],
        final.shape[0],
        final.shape[1],
    )

    start = center_crop_to_size(
        start,
        size,
    )

    final = center_crop_to_size(
        final,
        size,
    )

    return start, final


# ============================================================
# 90 DEGREE ROTATIONS
# ============================================================

def rotate_image(
    image: np.ndarray,
    degrees: int,
) -> np.ndarray:

    if degrees == 0:
        return image.copy()

    if degrees == 90:
        return cv2.rotate(
            image,
            cv2.ROTATE_90_CLOCKWISE,
        )

    if degrees == 180:
        return cv2.rotate(
            image,
            cv2.ROTATE_180,
        )

    if degrees == 270:
        return cv2.rotate(
            image,
            cv2.ROTATE_90_COUNTERCLOCKWISE,
        )

    raise ValueError(
        f"Unsupported rotation: {degrees}"
    )


# ============================================================
# EDGE REPRESENTATION FOR PHASE CORRELATION
# ============================================================

def phase_representation(
    image: np.ndarray,
) -> np.ndarray:

    x = cv2.GaussianBlur(
        image,
        (5, 5),
        0,
    ).astype(
        np.float32
    )

    x /= 255.0

    gx = cv2.Sobel(
        x,
        cv2.CV_32F,
        1,
        0,
        ksize=3,
    )

    gy = cv2.Sobel(
        x,
        cv2.CV_32F,
        0,
        1,
        ksize=3,
    )

    magnitude = cv2.magnitude(
        gx,
        gy,
    )

    magnitude -= float(
        magnitude.mean()
    )

    return magnitude


# ============================================================
# COARSE X/Y ALIGNMENT
# ============================================================

def coarse_phase_align(
    reference: np.ndarray,
    moving: np.ndarray,
):
    """
    Find coarse X/Y displacement before ECC.
    """

    reference_phase = phase_representation(
        reference
    )

    moving_phase = phase_representation(
        moving
    )

    h, w = reference.shape

    window = cv2.createHanningWindow(
        (w, h),
        cv2.CV_32F,
    )

    try:

        (
            dx,
            dy,
        ), response = cv2.phaseCorrelate(
            reference_phase,
            moving_phase,
            window,
        )

    except cv2.error:

        return (
            moving.copy(),
            -1.0,
        )

    maximum_shift = (
        MAX_PHASE_SHIFT_FRACTION
        * min(
            h,
            w,
        )
    )

    # Reject crazy displacement
    if (
        abs(dx) > maximum_shift
        or
        abs(dy) > maximum_shift
    ):

        return (
            moving.copy(),
            float(response),
        )

    translation = np.array(
        [
            [
                1.0,
                0.0,
                -dx,
            ],
            [
                0.0,
                1.0,
                -dy,
            ],
        ],
        dtype=np.float32,
    )

    aligned = cv2.warpAffine(
        moving,
        translation,
        (w, h),
        flags=cv2.INTER_LINEAR,
        borderMode=cv2.BORDER_REFLECT101,
    )

    return (
        aligned,
        float(response),
    )


# ============================================================
# PREPARE IMAGE FOR ECC
# ============================================================

def prepare_for_ecc(
    image: np.ndarray,
) -> np.ndarray:

    x = cv2.GaussianBlur(
        image,
        (5, 5),
        0,
    ).astype(
        np.float32
    )

    x /= 255.0

    mean = float(
        x.mean()
    )

    std = float(
        x.std()
    )

    if std < 1e-8:

        return np.zeros_like(
            x,
            dtype=np.float32,
        )

    return (
        x - mean
    ) / std


# ============================================================
# ECC FINE ALIGNMENT
# ============================================================

def fine_ecc_align(
    reference: np.ndarray,
    moving: np.ndarray,
):
    """
    First try EUCLIDEAN:

        translation + small-angle rotation

    If it fails, fall back to translation-only.

    Homography is deliberately NOT used because we do not
    want the registration algorithm to deform real defects.
    """

    template = prepare_for_ecc(
        reference
    )

    input_image = prepare_for_ecc(
        moving
    )

    h, w = reference.shape

    criteria = (
        cv2.TERM_CRITERIA_EPS
        |
        cv2.TERM_CRITERIA_COUNT,
        ECC_ITERATIONS,
        ECC_EPSILON,
    )

    motion_models = (
        cv2.MOTION_EUCLIDEAN,
        cv2.MOTION_TRANSLATION,
    )

    for motion_model in motion_models:

        warp = np.eye(
            2,
            3,
            dtype=np.float32,
        )

        try:

            score, warp = cv2.findTransformECC(
                template,
                input_image,
                warp,
                motion_model,
                criteria,
                None,
                5,
            )

            aligned = cv2.warpAffine(
                moving,
                warp,
                (w, h),
                flags=(
                    cv2.INTER_LINEAR
                    |
                    cv2.WARP_INVERSE_MAP
                ),
                borderMode=cv2.BORDER_REFLECT101,
            )

            return (
                aligned,
                float(score),
            )

        except cv2.error:
            continue

    return (
        moving.copy(),
        -1.0,
    )


# ============================================================
# PHOTOMETRIC NORMALIZATION
# ============================================================

def photometric_match(
    reference: np.ndarray,
    moving: np.ndarray,
) -> np.ndarray:
    """
    Match global brightness and contrast of Final to Start.

    Approximate model:

        Final_corrected = a * Final + b

    Limits prevent extreme corrections.
    """

    ref = reference.astype(
        np.float32
    )

    mov = moving.astype(
        np.float32
    )

    mean_ref = float(
        ref.mean()
    )

    std_ref = float(
        ref.std()
    )

    mean_mov = float(
        mov.mean()
    )

    std_mov = float(
        mov.std()
    )

    if std_mov < 1e-7:
        return moving.copy()

    scale = (
        std_ref
        /
        std_mov
    )

    scale = float(
        np.clip(
            scale,
            0.70,
            1.40,
        )
    )

    offset = (
        mean_ref
        -
        scale * mean_mov
    )

    offset = float(
        np.clip(
            offset,
            -45.0,
            45.0,
        )
    )

    result = (
        scale * mov
        +
        offset
    )

    return np.clip(
        result,
        0,
        255,
    ).astype(
        np.uint8
    )


# ============================================================
# INNER AREA FOR ALIGNMENT SCORE
# ============================================================

def inner_view(
    image: np.ndarray,
    fraction: float = 0.05,
) -> np.ndarray:
    """
    Remove outer few percent when measuring alignment quality.
    """

    h, w = image.shape

    border = int(
        round(
            min(
                h,
                w,
            )
            * fraction
        )
    )

    if (
        border <= 0
        or
        2 * border >= min(h, w)
    ):
        return image

    return image[
        border:h - border,
        border:w - border
    ]


# ============================================================
# TRY 0 / 90 / 180 / 270
# ============================================================

def find_best_alignment(
    start: np.ndarray,
    final: np.ndarray,
):
    """
    Try all four possible 90-degree orientations.

    For every orientation:

        coarse phase correlation
        ->
        ECC fine alignment
        ->
        photometric matching
        ->
        SSIM scoring

    Keep the best.
    """

    best_score = -1e30
    best_result = None

    for rotation in (
        0,
        90,
        180,
        270,
    ):

        candidate = rotate_image(
            final,
            rotation,
        )

        # ====================================================
        # Coarse translation
        # ====================================================

        candidate, phase_response = coarse_phase_align(
            start,
            candidate,
        )

        # ====================================================
        # Fine alignment
        # ====================================================

        candidate, ecc_score = fine_ecc_align(
            start,
            candidate,
        )

        # ====================================================
        # Normalize illumination
        # ====================================================

        candidate = photometric_match(
            start,
            candidate,
        )

        # ====================================================
        # Alignment score
        # ====================================================

        start_inner = inner_view(
            start
        )

        final_inner = inner_view(
            candidate
        )

        ssim = float(
            structural_similarity(
                start_inner,
                final_inner,
                data_range=255,
            )
        )

        # SSIM is the main criterion.
        #
        # ECC and phase score only provide a tiny tie-break.
        total_score = (
            ssim
            +
            0.015
            * max(
                ecc_score,
                0.0,
            )
            +
            0.003
            * max(
                phase_response,
                0.0,
            )
        )

        if total_score > best_score:

            best_score = total_score

            best_result = (
                candidate,
                rotation,
                phase_response,
                ecc_score,
            )

    if best_result is None:

        raise RuntimeError(
            "Could not align Start/Final pair."
        )

    return best_result


# ============================================================
# VALID IMAGE REGION
# ============================================================

def create_valid_mask(
    shape,
) -> np.ndarray:

    h, w = shape

    mask = np.ones(
        (
            h,
            w,
        ),
        dtype=np.uint8,
    )

    border = min(
        BORDER_IGNORE_PX,
        min(h, w) // 10,
    )

    if border > 0:

        mask[
            :border,
            :
        ] = 0

        mask[
            -border:,
            :
        ] = 0

        mask[
            :,
            :border
        ] = 0

        mask[
            :,
            -border:
        ] = 0

    return mask


# ============================================================
# ROBUST THRESHOLD USING MEDIAN / MAD
# ============================================================

def robust_threshold(
    data: np.ndarray,
    valid_mask: np.ndarray,
    k: float,
    minimum: float,
) -> float:

    values = data[
        valid_mask > 0
    ]

    if values.size == 0:
        return minimum

    median = float(
        np.median(
            values
        )
    )

    mad = float(
        np.median(
            np.abs(
                values - median
            )
        )
    )

    robust_sigma = (
        1.4826
        * mad
    )

    threshold = (
        median
        +
        k * robust_sigma
    )

    return float(
        max(
            minimum,
            threshold,
        )
    )


# ============================================================
# GRADIENT
# ============================================================

def gradient_magnitude(
    image: np.ndarray,
) -> np.ndarray:

    x = cv2.GaussianBlur(
        image,
        (3, 3),
        0,
    ).astype(
        np.float32
    )

    x /= 255.0

    gx = cv2.Sobel(
        x,
        cv2.CV_32F,
        1,
        0,
        ksize=3,
    )

    gy = cv2.Sobel(
        x,
        cv2.CV_32F,
        0,
        1,
        ksize=3,
    )

    return cv2.magnitude(
        gx,
        gy,
    )


# ============================================================
# BUILD CLASSICAL CHANGE MAPS
# ============================================================

def build_change_maps(
    start: np.ndarray,
    final: np.ndarray,
):
    """
    Build:

        absolute difference
        SSIM difference
        gradient difference
        combined difference
    """

    # Very small blur reduces camera/sensor noise.
    start_blur = cv2.GaussianBlur(
        start,
        (3, 3),
        0.7,
    )

    final_blur = cv2.GaussianBlur(
        final,
        (3, 3),
        0.7,
    )

    # ========================================================
    # 1. Absolute difference
    # ========================================================

    abs_difference = cv2.absdiff(
        start_blur,
        final_blur,
    ).astype(
        np.float32
    )

    abs_difference /= 255.0

    # ========================================================
    # 2. SSIM local difference
    # ========================================================

    global_ssim, ssim_similarity_map = (
        structural_similarity(
            start_blur,
            final_blur,
            data_range=255,
            full=True,
        )
    )

    ssim_difference = (
        1.0
        -
        ssim_similarity_map.astype(
            np.float32
        )
    )

    ssim_difference = np.clip(
        ssim_difference,
        0.0,
        1.0,
    )

    # ========================================================
    # 3. Gradient difference
    # ========================================================

    start_gradient = gradient_magnitude(
        start_blur
    )

    final_gradient = gradient_magnitude(
        final_blur
    )

    gradient_difference = np.abs(
        final_gradient
        -
        start_gradient
    )

    gradient_scale = float(
        np.percentile(
            gradient_difference,
            99.5,
        )
    )

    if gradient_scale > 1e-8:

        gradient_difference /= (
            gradient_scale
        )

        gradient_difference = np.clip(
            gradient_difference,
            0.0,
            1.0,
        )

    else:

        gradient_difference = np.zeros_like(
            gradient_difference,
            dtype=np.float32,
        )

    # ========================================================
    # Combined
    # ========================================================

    combined = (
        WEIGHT_ABSDIFF
        * abs_difference
        +
        WEIGHT_SSIM
        * ssim_difference
        +
        WEIGHT_GRADIENT
        * gradient_difference
    )

    combined = np.clip(
        combined,
        0.0,
        1.0,
    )

    return (
        abs_difference,
        ssim_difference,
        gradient_difference,
        combined,
        float(global_ssim),
    )


# ============================================================
# DETECT SIGNIFICANT CHANGED PIXELS
# ============================================================

def create_change_mask(
    abs_difference: np.ndarray,
    ssim_difference: np.ndarray,
    gradient_difference: np.ndarray,
    combined: np.ndarray,
    valid_mask: np.ndarray,
):
    """
    Require multiple algorithms to agree.

    This is much less strict than:
        "if any metric says different -> reject"
    """

    combined_threshold = robust_threshold(
        combined,
        valid_mask,
        COMBINED_MAD_K,
        MIN_COMBINED_THRESHOLD,
    )

    abs_threshold = robust_threshold(
        abs_difference,
        valid_mask,
        ABSDIFF_MAD_K,
        MIN_ABSDIFF_THRESHOLD,
    )

    ssim_threshold = robust_threshold(
        ssim_difference,
        valid_mask,
        SSIM_MAD_K,
        MIN_SSIM_DIFF_THRESHOLD,
    )

    gradient_threshold = robust_threshold(
        gradient_difference,
        valid_mask,
        GRADIENT_MAD_K,
        MIN_GRADIENT_THRESHOLD,
    )

    # ========================================================
    # Independent evidence
    # ========================================================

    evidence = (
        (
            abs_difference
            >
            abs_threshold
        ).astype(np.uint8)
        +
        (
            ssim_difference
            >
            ssim_threshold
        ).astype(np.uint8)
        +
        (
            gradient_difference
            >
            gradient_threshold
        ).astype(np.uint8)
    )

    # A pixel is suspicious only if:
    #
    # 1. combined score is strong
    # 2. at least TWO methods agree
    # 3. pixel is inside valid region

    binary = (
        (
            combined
            >
            combined_threshold
        )
        &
        (
            evidence >= 2
        )
        &
        (
            valid_mask > 0
        )
    ).astype(
        np.uint8
    )

    # ========================================================
    # Morphological noise cleanup
    # ========================================================

    opening_kernel = cv2.getStructuringElement(
        cv2.MORPH_ELLIPSE,
        (3, 3),
    )

    binary = cv2.morphologyEx(
        binary,
        cv2.MORPH_OPEN,
        opening_kernel,
    )

    closing_kernel = cv2.getStructuringElement(
        cv2.MORPH_ELLIPSE,
        (5, 5),
    )

    binary = cv2.morphologyEx(
        binary,
        cv2.MORPH_CLOSE,
        closing_kernel,
    )

    return binary


# ============================================================
# REMOVE SMALL COMPONENTS
# ============================================================

def analyze_components(
    binary: np.ndarray,
    valid_mask: np.ndarray,
):
    """
    Remove tiny connected components and calculate:

        total changed ratio
        largest changed component ratio
    """

    (
        n_labels,
        labels,
        stats,
        centroids,
    ) = cv2.connectedComponentsWithStats(
        binary,
        connectivity=8,
    )

    cleaned = np.zeros_like(
        binary
    )

    areas = []

    for label in range(
        1,
        n_labels,
    ):

        area = int(
            stats[
                label,
                cv2.CC_STAT_AREA,
            ]
        )

        if area < MIN_COMPONENT_AREA_PX:
            continue

        cleaned[
            labels == label
        ] = 1

        areas.append(
            area
        )

    valid_pixels = max(
        1,
        int(
            np.sum(
                valid_mask > 0
            )
        ),
    )

    changed_pixels = int(
        np.sum(
            cleaned > 0
        )
    )

    changed_ratio = (
        changed_pixels
        /
        valid_pixels
    )

    largest_area = (
        max(areas)
        if areas
        else 0
    )

    largest_component_ratio = (
        largest_area
        /
        valid_pixels
    )

    return (
        changed_ratio,
        largest_component_ratio,
        largest_area,
        len(areas),
    )


# ============================================================
# FINAL CLASSIFICATION
# ============================================================

def classify_pair(
    global_ssim: float,
    changed_ratio: float,
    largest_component_ratio: float,
):
    """
    Tolerant classification.

    SSIM alone can NEVER reject an image.
    """

    # ========================================================
    # Clearly large localized change
    # ========================================================

    if (
        largest_component_ratio
        >=
        STRONG_LOCAL_COMPONENT_RATIO
    ):

        return (
            "not_similar",
            "strong_local_change",
        )

    # ========================================================
    # Very large total changed area
    # ========================================================

    if (
        changed_ratio
        >=
        TOTAL_CHANGE_RATIO
    ):

        return (
            "not_similar",
            "large_total_change",
        )

    # ========================================================
    # Multiple evidence:
    # mediocre SSIM + actual changed area
    # ========================================================

    if (
        global_ssim
        <
        LOW_GLOBAL_SSIM
        and
        changed_ratio
        >=
        LOW_SSIM_CHANGE_RATIO
    ):

        return (
            "not_similar",
            "local_change_plus_low_ssim",
        )

    return (
        "similar",
        "no_convincing_new_defect",
    )


# ============================================================
# EXTRACT UNIT
# ============================================================

def extract_unit(
    path: Path,
) -> Optional[str]:

    match = UNIT_RE.search(
        path.name
    )

    if match is None:
        return None

    return match.group(1)


# ============================================================
# EXTRACT TIMESTAMP
# ============================================================

def timestamp_sort_key(
    path: Path,
):
    """
    Used for retests.

    Start and Final images for the same Rc##Cc##
    are sorted chronologically before pairing.
    """

    match = TIMESTAMP_RE.search(
        path.name
    )

    if match:

        try:

            dt = datetime.strptime(
                match.group(1),
                "%Y%m%dT%H%M%S",
            )

            return (
                0,
                dt,
                path.name.lower(),
            )

        except ValueError:
            pass

    return (
        1,
        datetime.min,
        path.name.lower(),
    )


# ============================================================
# FIND TOP START / FINAL FILES
# ============================================================

def discover_images(
    root: Path,
):
    starts = {}
    finals = {}

    print(
        "\nSearching recursively for TOP images..."
    )

    for path in root.rglob("*"):

        if not path.is_file():
            continue

        if (
            path.suffix.lower()
            not in
            IMAGE_EXTENSIONS
        ):
            continue

        unit = extract_unit(
            path
        )

        if unit is None:
            continue

        lower_name = (
            path.name.lower()
        )

        if (
            START_TOKEN.lower()
            in lower_name
        ):

            starts.setdefault(
                unit,
                [],
            ).append(
                path
            )

        elif (
            FINAL_TOKEN.lower()
            in lower_name
        ):

            finals.setdefault(
                unit,
                [],
            ).append(
                path
            )

    # Chronological sorting
    for dictionary in (
        starts,
        finals,
    ):

        for paths in dictionary.values():

            paths.sort(
                key=timestamp_sort_key
            )

    return (
        starts,
        finals,
    )


# ============================================================
# BUILD PAIRS
# ============================================================

def build_pairs(
    starts,
    finals,
):
    pairs = []

    units = sorted(
        set(starts)
        |
        set(finals)
    )

    for unit in units:

        unit_starts = starts.get(
            unit,
            [],
        )

        unit_finals = finals.get(
            unit,
            [],
        )

        if (
            len(unit_starts)
            !=
            len(unit_finals)
        ):

            print(
                f"\nWARNING {unit}: "
                f"{len(unit_starts)} Start, "
                f"{len(unit_finals)} Final"
            )

            print(
                "Will pair chronologically up to "
                "the shorter list."
            )

        number_pairs = min(
            len(unit_starts),
            len(unit_finals),
        )

        for index in range(
            number_pairs
        ):

            pairs.append(
                (
                    unit,
                    index + 1,
                    unit_starts[index],
                    unit_finals[index],
                )
            )

    return pairs


# ============================================================
# REMOVE OLD VERSION OF THE SAME PAIR
# ============================================================

def remove_old_pair_output(
    pair_name: str,
):
    """
    Important when rerunning:

    If a pair was previously NOT_SIMILAR but now becomes
    SIMILAR, remove its old folder.

    Also guarantees that each pair subfolder contains
    ONLY the two requested PNG files.
    """

    for category in (
        "similar",
        "not_similar",
    ):

        old_folder = (
            OUTPUT_ROOT
            /
            category
            /
            pair_name
        )

        if old_folder.exists():

            shutil.rmtree(
                old_folder
            )


# ============================================================
# PROCESS ONE START / FINAL PAIR
# ============================================================

def process_pair(
    unit: str,
    pair_number: int,
    start_path: Path,
    final_path: Path,
):
    # ========================================================
    # 1. LOAD RAW IMAGES
    # ========================================================

    start_raw = load_gray(
        start_path
    )

    final_raw = load_gray(
        final_path
    )

    # ========================================================
    # 2. CROP TOP DIE FIRST
    # ========================================================

    start_crop = detect_top_die(
        start_raw
    )

    final_crop = detect_top_die(
        final_raw
    )

    # Same size WITHOUT resizing
    (
        start_crop,
        final_crop,
    ) = make_same_square(
        start_crop,
        final_crop,
    )

    # ========================================================
    # 3. ROTATE + ALIGN FINAL TO START
    # ========================================================

    (
        final_aligned,
        rotation,
        phase_response,
        ecc_score,
    ) = find_best_alignment(
        start_crop,
        final_crop,
    )

    # ========================================================
    # 4. CLASSICAL COMPARISON
    # ========================================================

    (
        abs_difference,
        ssim_difference,
        gradient_difference,
        combined,
        global_ssim,
    ) = build_change_maps(
        start_crop,
        final_aligned,
    )

    valid_mask = create_valid_mask(
        combined.shape
    )

    binary = create_change_mask(
        abs_difference,
        ssim_difference,
        gradient_difference,
        combined,
        valid_mask,
    )

    (
        changed_ratio,
        largest_component_ratio,
        largest_component_area,
        number_components,
    ) = analyze_components(
        binary,
        valid_mask,
    )

    # ========================================================
    # 5. SIMILAR / NOT_SIMILAR
    # ========================================================

    (
        classification,
        reason,
    ) = classify_pair(
        global_ssim,
        changed_ratio,
        largest_component_ratio,
    )

    # ========================================================
    # 6. OUTPUT
    # ========================================================

    pair_name = (
        f"{unit}_pair_{pair_number:02d}"
    )

    # Delete any previous output for this pair.
    remove_old_pair_output(
        pair_name
    )

    output_folder = (
        OUTPUT_ROOT
        /
        classification
        /
        pair_name
    )

    output_folder.mkdir(
        parents=True,
        exist_ok=True,
    )

    # ========================================================
    # SAVE EXACTLY TWO IMAGES
    # ========================================================

    before_output = (
        output_folder
        /
        "before_cropped.png"
    )

    final_output = (
        output_folder
        /
        "final_cropped_aligned.png"
    )

    success_before = cv2.imwrite(
        str(before_output),
        start_crop,
    )

    success_final = cv2.imwrite(
        str(final_output),
        final_aligned,
    )

    if not success_before:
        raise RuntimeError(
            f"Could not save:\n{before_output}"
        )

    if not success_final:
        raise RuntimeError(
            f"Could not save:\n{final_output}"
        )

    # ========================================================
    # RETURN METRICS ONLY TO CONSOLE
    # Nothing else is saved.
    # ========================================================

    return {
        "unit": unit,
        "pair_number": pair_number,
        "classification": classification,
        "reason": reason,
        "rotation": rotation,
        "phase_response": phase_response,
        "ecc_score": ecc_score,
        "global_ssim": global_ssim,
        "changed_ratio": changed_ratio,
        "largest_component_ratio": largest_component_ratio,
        "largest_component_area": largest_component_area,
        "number_components": number_components,
    }


