def process_folder(
    position,
    label
):

    input_folder = (
        INPUT_ROOT
        /
        position
        /
        label
    )


    output_folder = (
        OUTPUT_ROOT
        /
        position
        /
        label
    )


    debug_folder = (
        OUTPUT_ROOT
        /
        OUTPUT_NAMES["debug"]
        /
        position
        /
        label
    )


    missing_folder = (
        OUTPUT_ROOT
        /
        OUTPUT_NAMES["missing"]
        /
        position
        /
        label
    )


    missing_debug_folder = (
        OUTPUT_ROOT
        /
        OUTPUT_NAMES["missing_debug"]
        /
        position
        /
        label
    )


    if not input_folder.exists():

        print(
            f"[MISSING INPUT] "
            f"{input_folder}"
        )

        return


    total = 0
    processed = 0
    missing = 0


    print()

    print(
        "=" * 80
    )


    print(
        f"PROCESSING: "
        f"{position} / {label}"
    )


    print(
        f"INPUT:  "
        f"{input_folder}"
    )


    print(
        f"OUTPUT: "
        f"{output_folder}"
    )


    print(
        "=" * 80
    )


    for image_path in sorted(
        input_folder.iterdir()
    ):

        if not image_path.is_file():

            continue


        if (
            image_path.suffix.lower()
            not in IMAGE_EXTENSIONS
        ):

            continue


        total += 1


        if position == "ViTop":

            success = process_top(

                image_path,

                output_folder,

                debug_folder,

                missing_folder,

                missing_debug_folder
            )


        elif position == "ViBottom":

            success = process_bottom(

                image_path,

                output_folder,

                debug_folder,

                missing_folder,

                missing_debug_folder
            )


        else:

            print(
                f"[UNKNOWN DATASET POSITION] {position}"
            )

            return


        if success:

            processed += 1


        else:

            missing += 1


    print()

    print(
        f"{position}/{label}: "
        f"{processed}/{total} processed "
        f"| Missing={missing}"
    )


